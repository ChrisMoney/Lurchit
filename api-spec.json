{
  "swagger": "2.0",
  "info": {
    "version": "",
    "title": "Flickpitch",
    "description": "Flickpitch APIs"
  },
  "host": "api.flickpitch.com",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
