      "get": {
        "operationId": "GET_signup-php",
        "summary": "Signup",
        "parameters": [
          {
            "name": "FirstName",
            "in": "query",
            "required": true,
            "type": "string"
          },
          {
            "name": "LastName",
            "in": "query",
            "required": true,
            "type": "string"
          },
          {
            "name": "Username",
            "in": "query",
            "required": true,
            "type": "string"
          },
          {
            "name": "Email",
            "in": "query",
            "required": true,
            "type": "string"
          },
          {
            "name": "Password",
            "in": "query",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "integer",
              "description": "User signed up successfully."
            }
          },
          "400": {
            "description": "",
            "schema": {
              "type": "integer",
              "description": "User input bad."
            }
          },
          "406": {
            "description": "",
            "schema": {
              "type": "integer",
              "description": "Username already exists."
            }
          },
          "409": {
            "description": "",
            "schema": {
              "type": "integer",
              "description": "Account already exists."
            }
          },
          "500": {
            "description": "",
            "schema": {
              "type": "integer",
              "description": "Sign up failed."
            }
          }
        }
      }
    },
    "/login.php": {
      "get": {
        "operationId": "GET_login-php",
        "summary": "Login",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "type": "string"
          },
          {
            "name": "password",
            "in": "query",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "integer",
              "description": "Successful signup."
            },
            "examples": {
              "application/json": {
                "ID": 98124060
              }
            }
          },
          "400": {
            "description": "",
            "schema": {
              "type": "integer",
